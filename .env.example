# Copy this file to .env before using Docker Compose. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
POSTGRES_DB=gradapp
POSTGRES_USER=gradapp
POSTGRES_PASSWORD=replace-with-a-strong-database-password
VITE_API_URL=http://localhost:8000/api

# Load the fictional sample dataset on startup (set to false for real data).
SEED_SAMPLE_DATA=true

# Optional: create an administrator account on first start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Optional: enable OpenAI-powered features (AI answers, AI extraction, summaries).
# Without a key, GradApp uses rule-based recommendations and keyword answers.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Search the web when GradApp's records can't answer, and save what is found (uses extra API calls).
AI_WEB_SEARCH_ENABLED=true
